<mxfile host="app.diagrams.net">
  <diagram name="Slide10_ContinuumGradient" id="slide10diagram">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Marqueur Mistral au-dessus de la zone 2 -->
        <mxCell id="mistral_label" value="Mistral est ici" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#D79B00;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="mistral_arrow" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mistral_label" target="zone2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 4 zones du continuum, cote a cote -->
        <mxCell id="zone1" value="FERMÉ / API&#10;&#10;GPT, Claude,&#10;Gemini" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="zone2" value="OPEN WEIGHT&#10;&#10;Llama, Mistral,&#10;DeepSeek" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="100" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="zone3" value="OPEN WEIGHT++&#10;&#10;gpt-oss, Gemma,&#10;Qwen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="220" height="180" as="geometry" />
        </mxCell>
        <mxCell id="zone4" value="OPEN SOURCE&#10;&#10;OLMo, Apertus,&#10;Luciole" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- Fleche de progression sous les zones -->
        <mxCell id="progress_arrow" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="40" y="310" as="sourcePoint" />
            <mxPoint x="920" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="progress_label" value="Ouverture croissante" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="325" width="200" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
