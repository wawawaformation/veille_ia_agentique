<mxfile host="app.diagrams.net">
  <diagram name="Slide21_CarteRGPD" id="slide21diagram">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Titre -->
        <mxCell id="titre" value="Le vrai dilemme : large choix ou souveraineté ?" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="640" height="30" as="geometry" />
        </mxCell>

        <!-- Colonne OLLAMA (USA) -->
        <mxCell id="ollama_titre" value="OLLAMA (USA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ollama_plus" value="✓ Large catalogue&#10;(dizaines de modèles open weight/source)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ollama_moins" value="✗ RGPD : transfert hors UE&#10;(infrastructure USA, article 44)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- Colonne INFOMANIAK (Suisse) -->
        <mxCell id="info_titre" value="INFOMANIAK (Suisse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="info_plus" value="✓ RGPD conforme&#10;(adéquation UE, 100% infra suisse)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="420" y="130" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="info_moins" value="✗ Catalogue plus restreint&#10;(8 modèles, dont Apertus — open source suisse)" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="420" y="190" width="280" height="50" as="geometry" />
